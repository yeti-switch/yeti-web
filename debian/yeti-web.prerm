#!/bin/bash

services="yeti-web.service yeti-cdr-processor@billing.service yeti-cdr-processor@stats.service yeti-prometheus.service"
services="${services} yeti-delayed-job@0.service yeti-delayed-job@1.service yeti-delayed-job@2.service yeti-delayed-job@3.service"

if [ -d /run/systemd/system ] && [ -x /usr/bin/deb-systemd-invoke ]; then
	deb-systemd-invoke stop ${services} >/dev/null
fi

exit 0
