# Possible values: debug, info, warn, error, fatal
log_level: info

prometheus:
  enabled: false
  host: localhost
  port: 9394
  default_labels:
    host: my-host

billing:
  mode: production
  class: cdr_billing
  queue: cdr_billing
  consumer: cdr_billing

stats:
  mode: production
  class: cdr_stat
  queue: cdr_stats
  consumer: cdr_stats
  stored_procedure: switch.async_cdr_statistics

http:
  mode: production
  class: cdr_http
  queue: cdr_billing
  consumer: cdr_billing
  url: "http://example.com/api/cdrs"
  method: POST
  # auth_user: user
  # auth_password: password
  # Outbound proxy. Defaults to direct (ignores any HTTP(S)_PROXY env vars).
  # Set http_proxy to force a proxy, or use_env_proxy: true to honour the env
  # vars when http_proxy is unset.
  # http_proxy: http://proxy.example.com:3128
  # use_env_proxy: false
  # may be an array:
  #  cdr_fields: [
  #                 'id', 'src_prefix_in', 'src_prefix_out', 'dst_prefix_in', 'dst_prefix_out', 'time_start',
  #                 'time_connect', 'time_end',  'duration', 'customer', 'vendor',  'destination_fee',
  #                 'destination_initial_interval', 'destination_initial_rate', 'destination_next_interval',
  #                 'destination_next_rate', 'customer_price',  'orig_call_id', 'local_tag', 'term_call_id'
  #              ]
  cdr_fields: all
  # data_filters - optional list of filters, all must match for event to be sent.
  # Available operators: eq, not_eq, start_with, end_with, contains,
  #                      gt, lt, gte, lte, in, not_in, null, not_null, true, false
  # data_filters:
  #   - field: duration
  #     op: gt
  #     value: 0
  #   - field: customer_price
  #     op: not_null
  #     value:
  #   - field: dst_prefix_in
  #     op: start_with
  #     value: "380"
  #   - field: vendor_id
  #     op: in
  #     value: [1, 2, 3]
  # Custom static headers. Cannot override built-in headers: X-Request-Id, X-Yeti-Cdr-*.
  # headers:
  #   content-type: "application/json"
  #   accept: "application/json"
  #   X-Api-Key: "secret-key"
  # Sends each CDR as a separate HTTP request.
  # Supported methods: POST, PUT, PATCH
  # Built-in headers (always set):
  #   X-Request-Id: <uuid>
  #   X-Yeti-Cdr-Batch-Id: <batch_id>
  #   X-Yeti-Cdr-Event-Id: <event_id>
  # Payload:
  #   {"id": 1, "duration": 2, "src_prefix_in": "123", ...}

http_batch:
  mode: production
  class: cdr_http_batch
  queue: cdr_billing
  consumer: cdr_http_batch
  url: "http://example.com/api/cdrs"
  method: POST
  # auth_user: user
  # auth_password: password
  # Outbound proxy. Defaults to direct (ignores any HTTP(S)_PROXY env vars).
  # Set http_proxy to force a proxy, or use_env_proxy: true to honour the env
  # vars when http_proxy is unset.
  # http_proxy: http://proxy.example.com:3128
  # use_env_proxy: false
  # may be an array:
  #  cdr_fields: [
  #                 'id', 'src_prefix_in', 'src_prefix_out', 'dst_prefix_in', 'dst_prefix_out', 'time_start',
  #                 'time_connect', 'time_end',  'duration', 'customer', 'vendor',  'destination_fee',
  #                 'destination_initial_interval', 'destination_initial_rate', 'destination_next_interval',
  #                 'destination_next_rate', 'customer_price',  'orig_call_id', 'local_tag', 'term_call_id'
  #              ]
  cdr_fields: all
  # Sends all CDRs from a batch in a single HTTP request.
  # Built-in headers (always set):
  #   X-Request-Id: <uuid>
  #   X-Yeti-Cdr-Batch-Id: <batch_id>
  # Payload:
  #   {"batch_id": 12345, "data": [{"id": 1, ...}, {"id": 2, ...}]}

http_bulk:
  mode: production
  class: cdr_http_bulk
  queue: cdr_billing
  # Every consumer needs its own registration in the CDR database:
  #   SELECT pgq.register_consumer('cdr_billing', 'cdr_http_bulk');
  # Register it only when the processor is actually going to run - pgq keeps
  # every event of a registered consumer until it is consumed, so an idle
  # registered consumer makes the queue grow without bound.
  consumer: cdr_http_bulk
  url: "http://example.com/api/cdrs"
  # Maximum number of CDRs per HTTP request. Omit it to send the whole pgq
  # batch in a single request.
  bulk_size: 500
  # When set, the request body is signed with HMAC-SHA256 and the hex digest is
  # sent in the X-HMAC-Signature header.
  # hmac_secret: "secret"
  # auth_user: user
  # auth_password: password
  # Outbound proxy. Defaults to direct (ignores any HTTP(S)_PROXY env vars).
  # http_proxy: http://proxy.example.com:3128
  # use_env_proxy: false
  # may be an array, see the http section above
  cdr_fields: all
  # data_filters - same syntax as in the http section above.
  # Custom static headers. Cannot override built-in headers: X-Request-Id,
  # X-Yeti-Cdr-*, X-HMAC-Signature.
  # headers:
  #   X-Api-Key: "secret-key"
  # Sends CDRs in bulks of bulk_size, acknowledging each bulk once its request
  # succeeded, so a restart resumes at the first unsent bulk.
  # Supported method: POST
  # Built-in headers (always set):
  #   X-Request-Id: <uuid>
  #   X-Yeti-Cdr-Batch-Id: <batch_id>
  #   X-HMAC-Signature: <hexdigest>  (only when hmac_secret is set)
  # Payload:
  #   {"event_bulk_id": "9f2c...", "batch_id": 12345,
  #    "data": [{"type": "cdr_full", "payload": {"id": 1, ...}}]}

amqp:
  mode: production
  class: cdr_amqp
  queue: cdr_streaming
  consumer: cdr_amqp
  connect:
    host: "127.0.0.1"
    port: 5672
    ssl: false
    vhost: "/"
    user: "guest"
    pass: "guest"
    heartbeat: :server
    frame_max: 131072
    auth_mechanism: "PLAIN"

clickhouse:
  mode: production
  class: cdr_clickhouse
  queue: cdr_billing
  consumer: cdr_clickhouse
  url: "http://clickhouse.example.com"
  # auth_user: user
  # auth_password: password
  clickhouse_db: main
  clickhouse_table: cdrs
  # may be an array:
  #  cdr_fields: [
  #                 'id', 'src_prefix_in', 'src_prefix_out', 'dst_prefix_in', 'dst_prefix_out', 'time_start',
  #                 'time_connect', 'time_end',  'duration', 'customer', 'vendor',  'destination_fee',
  #                 'destination_initial_interval', 'destination_initial_rate', 'destination_next_interval',
  #                 'destination_next_rate', 'customer_price',  'orig_call_id', 'local_tag', 'term_call_id'
  #              ]
  cdr_fields: all
