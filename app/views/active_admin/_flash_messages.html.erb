<%# Overrides ActiveAdmin 4's partial. Keep in sync with the gem on upgrade.

    Two deltas, both restoring ActiveAdmin 3 behaviour:

    1. Renders EVERY flash type. AA3 built these generically —
       `flash_messages.each { |type, msg| div msg, class: "flash flash_#{type}" }`
       (views/pages/base.rb) — while AA4 hardcodes an if/elsif over error, alert
       and notice and silently drops anything else. This app relies on more than
       those three: `flash[:warning]` is set in 21 places, and
       ResourceDSL::WithDefaultParams defaults to `:notice_message` (the "records
       for time interval N seconds are displayed by default" hint). Every one of
       those messages was invisible to users after the upgrade.

    2. Adds the semantic hooks AA4 leaves out: `role="alert"` so screen readers
       announce the message, `.flashes` on the container and `.flash flash_<type>`
       on each message. AA4 distinguishes its three types only by Tailwind colour
       utilities, so without this nothing can style or select a flash by type.

    Colours are AA4's, mapped by type; an unrecognised type falls back to the
    neutral/info palette rather than vanishing. %>
<%
  flash_palettes = {
    'error' => 'bg-red-50 text-red-800 dark:bg-red-800 dark:text-red-300',
    'error_message' => 'bg-red-50 text-red-800 dark:bg-red-800 dark:text-red-300',
    'alert' => 'bg-yellow-50 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-300',
    'warning' => 'bg-yellow-50 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-300',
    'warning_message' => 'bg-yellow-50 text-yellow-800 dark:bg-yellow-800 dark:text-yellow-300',
    'notice' => 'bg-green-50 text-green-800 dark:bg-green-800 dark:text-green-300',
    'notice_message' => 'bg-green-50 text-green-800 dark:bg-green-800 dark:text-green-300'
  }
  default_palette = 'bg-blue-50 text-blue-800 dark:bg-blue-800 dark:text-blue-300'

  # Icon per severity family. Reuses AA4's own three glyphs.
  error_icon = '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM10 15a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm1-4a1 1 0 0 1-2 0V6a1 1 0 0 1 2 0v5Z"/>'.html_safe
  warn_icon = '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>'.html_safe
  ok_icon = '<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>'.html_safe
%>
<% if flash_messages.present? %>
  <div class="flashes px-2.5 lg:px-5 mb-8">
    <% flash_messages.each do |type, messages| %>
      <% type = type.to_s %>
      <% Array(messages).each do |message| %>
        <%
          palette = flash_palettes.fetch(type, default_palette)
          icon = if type.start_with?('error') then error_icon
                 elsif type.start_with?('alert', 'warning') then warn_icon
                 elsif type.start_with?('notice') then ok_icon
                 end
        %>
        <div role="alert" class="flash flash_<%= type %> flex items-center gap-3 p-4 mb-2 rounded-lg <%= palette %>">
          <% if icon %>
            <svg class="w-5 h-5 shrink-0 rtl:-scale-x-100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20"><%= icon %></svg>
          <% end %>
          <%= message %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
